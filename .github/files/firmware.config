# Seed config for Radxa Cubie Allwinner Aiot firmware CI.
# Device profile is appended by the workflow (cubie-a7a or cubie-a7z).

CONFIG_TARGET_allwinner=y
CONFIG_TARGET_allwinner_aiot=y

# LuCI web UI (matches the default Cubie AP / serial image)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_en=y
CONFIG_LUCI_LANG_zh_Hans=y

# 802.11ax AP (hostapd is patched for HE; basic-mbedtls is enough for WPA2-PSK)
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_iwinfo=y

# On-board AIC8800 USB Wi-Fi (submodule package/kernel/aic8800-usb)
CONFIG_PACKAGE_kmod-aic8800-usb-shenmintao=y

# RTL8812AU USB station adapter (includes rtw88 RX recovery and firmware)
CONFIG_PACKAGE_kmod-rtw88-8812au=y

# OpenClash (submodule package/openclash)
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_kmod-tun=y
