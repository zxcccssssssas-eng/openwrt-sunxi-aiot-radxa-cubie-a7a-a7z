# Seed config for Radxa Cubie Allwinner Aiot firmware CI.
# Device profile is appended by the workflow (cubie-a7a or cubie-a7z).
#
# Default image: router/AP (LuCI, Wi-Fi, OpenClash).
# NPU and overclock are extra software: =m builds .ipk files without
# installing them into the squashfs. The workflow can promote them to =y.

CONFIG_TARGET_allwinner=y
CONFIG_TARGET_allwinner_aiot=y

# LuCI web UI (matches the default Cubie AP / serial image)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_en=y
CONFIG_LUCI_LANG_zh_Hans=y

# 802.11ax AP (hostapd is patched for HE; basic-mbedtls is enough for WPA2-PSK)
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_iwinfo=y

# On-board AIC8800 USB Wi-Fi (submodule package/kernel/aic8800-usb)
CONFIG_PACKAGE_kmod-aic8800-usb-shenmintao=y

# OpenClash (submodule package/openclash)
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_kmod-tun=y

# Extra software (not in the default image). Both NPU stacks are built as
# alternative ipks; they conflict at install time (same DT node).
CONFIG_PACKAGE_kmod-aw-nna-vip=m
CONFIG_PACKAGE_kmod-aw-nna-galcore=m
CONFIG_PACKAGE_kmod-sunxi-overclock=m
# GPU stays off unless extra_packages or menuconfig selects kmod-drm-powervr
# (that package pulls powervr-firmware into the image).
